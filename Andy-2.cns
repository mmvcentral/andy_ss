;--- コンボ補正 ---
[State -2, Combo Var]
type = varset
trigger1 = p2movetype != H
fv = 0
value = 1

[State -2, Combo Var]
type = varadd
triggerall = p2movetype = H
triggerall = stateno != 800
triggerall = stateno != 850
triggerall = stateno != [1650,1699]
triggerall = stateno != [2400,2499]
triggerall = stateno != 4000
triggerall = stateno != 200110
trigger1 = movehit = 1
fv = 0
value = -0.05

[State -2, Combo Var]
type = varset
trigger1 = stateno = [4000,4999]
trigger1 = fvar(0) < 0.5
fv = 0
value = 0.5

[State -2, Combo Var]
type = varset
trigger1 = stateno = [3000,3999]
trigger1 = fvar(0) < 0.4
fv = 0
value = 0.4

[State -2, Combo Var]
type = varset
trigger1 = fvar(0) < 0.2
fv = 0
value = 0.2

;--- パワーMAX ---
[State -2, PowerMAX Var]
type = varadd
trigger1 = sysfvar(2) = 0
trigger1 = fvar(2)
fv = 2
value = -1
ignorehitpause = 1

[State -2, PowerMAX Var]
type = varset
trigger1 = fvar(2) <= 0
trigger2 = !alive
trigger3 = roundstate < 2
fv = 2
value = 0

[State -2, PalFX]
type = palfx
trigger1 = sysfvar(2) = 0
trigger1 = gametime%3 = 1 && fvar(2)
trigger1 = movetype != H
time = 1
add = 80,80,60
ignorehitpause = 1

[State -2, PalFX]
type = palfx
trigger1 = sysfvar(2) = 0
trigger1 = gametime%3 = 2 && fvar(2)
trigger1 = movetype != H
time = 1
add = 40,40,30
ignorehitpause = 1

[State -2, Helper]
type = helper
trigger1 = fvar(2) && !numhelper(7120)
helpertype = normal
name = "Power MAX Gauge"
ownpal = 1
stateno = 7120
ID = 7120
postype = back
pos = 0,0
facing = 1
supermovetime = 999
pausemovetime = 999

;--- カウンター ---
[State -2, Counter Var]
type = varset
trigger1 = var(3) = 0 && p2movetype = A
v = 3
value = 2

[State -2, Counter Var]
type = varadd
trigger1 = var(3) && p2movetype != A
v = 3
value = -1

[State -2, Counter Var]
type = varset
trigger1 = var(3) < 0
trigger2 = stateno = 200110
v = 3
value = 0

[State -2, Counter Helper]
type = helper
triggerall = var(3)
triggerall = var(9) = 1
triggerall = p2movetype = H && numtarget
trigger1 = movehit = 1
helpertype = normal
name = "Counter Helper"
size.xscale = 0.5
size.yscale = 0.5
stateno = 7200
ID = 7200
postype = left
pos = 10,-100
pausemovetime = 2147483647
supermovetime = 2147483647
ignorehitpause = 1

;--- 基本攻撃力 ---
[State -2, Attack Var]
type = varset
trigger1 = 1
fv = 3
value = 1

;パワーMAX
[State -2, Attack Var]
type = varset
trigger1 = fvar(2)
fv = 3
value = fvar(3)*0.75;*1.2

;カウンター
[State -2, Attack Var]
type = varset
trigger1 = var(3)
fv = 3
value = fvar(3)*1.2

;ダウン追撃
[State -2, Attack Var]
type = VarSet
trigger1 = p2movetype = H
trigger1 = enemynear,gethitvar(fallcount) > 0
fv = 3
value = fvar(3)/(enemynear,const(data.fall.defence_mul)**(enemynear,gethitvar(fallcount)))

;--- スロー処理 ---
[State -2, Slow]
type = pause
triggerall = roundstate = 2
trigger1 = var(4) && (time%2) = 0
time = 1

[State -2, Slow Var]
type = varadd
trigger1 = var(4)
v = 4
value = -1

[State -2, Slow Var]
type = varset
trigger1 = var(4) < 0
v = 4
value = 0

;--- 飛び道具発射可能 ---
[State -2, VarSet]
type = varset
trigger1 = var(20)
v = 20
value = 0

[State -2, VarSet]
type = varset
triggerall = var(20) = 0
trigger1 = numhelper(1010)
trigger1 = helper(1010),stateno != 10100
trigger2 = numhelper(1060)
trigger2 = helper(1060),stateno != 10100
trigger3 = numhelper(2010)
trigger3 = helper(2010),stateno != 10100
trigger4 = numhelper(2060)
trigger4 = helper(2060),stateno != 10100
trigger5 = numhelper(2061)
trigger5 = helper(2061),stateno != 10100
v = 20
value = 1

;--- 当て投げ制限 ---
[State -2, VarSet]
type = varset
trigger1 = fvar(7) != 6
trigger1 = p2movetype = H || p2stateno = 5120
fv = 7
value = 6

[State -2, VarAdd]
type = varadd
trigger1 = fvar(7) > 0
trigger1 = p2movetype != H && p2stateno != 5120
fv = 7
value = -1

[State -2, VarSet]
type = varset
trigger1 = fvar(7) < 0
fv = 7
value = 0

;--- 
[State -2]
type = null;varset
trigger1 = stateno != 20 && stateno != 40
v = 57
value = 0

;--- ダッシュ音ストップ ---
[State -2, StopSnd]
type = stopsnd
trigger1 = stateno != 100
channel = 1

;--- 残像 ---
[State -2, AfterImageTime]
type = afterimagetime
trigger1 = sysvar(1) = 2 || sysvar(1) = -2
trigger1 = (vel y < 0 && statetype = A) || stateno = 40
trigger1 = movetype != H
time = 2
ignorehitpause = 1

;--- 空中ガード ---
[State -2, Air Guard]
type = assertspecial
trigger1 = var(36) = 0
flag = noairguard
ignorehitpause = 1

;--- 喰らいボイス ---
[State -2, Voice]
type = playsnd
triggerall = alive
triggerall = gethitvar(animtype) = 0
triggerall = random < 500
triggerall = time = 1
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070 || stateno = 5080
value = s5000,0
channel = 0

[State -2, Voice]
type = playsnd
triggerall = alive
triggerall = gethitvar(animtype) = 1
triggerall = random < 500
triggerall = time = 1
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070 || stateno = 5080
value = s5000,10
channel = 0


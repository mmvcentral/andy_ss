[State 9999, F]
type = varset
trigger1 = command = "holdfwd"
fv = 0
value = 2

[State 9999, F]
type = varadd
trigger1 = fvar(0)
trigger1 = root,hitpausetime = 0 && root,hitshakeover
fv = 0
value = -1

[State 9999, B]
type = varset
trigger1 = command = "holdback"
fv = 1
value = 2

[State 9999, B]
type = varadd
trigger1 = fvar(1)
trigger1 = root,hitpausetime = 0 && root,hitshakeover
fv = 1
value = -1

[State 9999, U]
